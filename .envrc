#!/usr/bin/env bash

source_up_if_exists

# The dev shell contains the built application, so reload it (and build
# anew) whenever the application changes. Nix only sees files that git
# tracks, so `git add` new ones.
watch_file Gemfile Gemfile.lock gemset.nix config.ru Rakefile
watch_dir app
watch_dir bin
watch_dir config
watch_dir public

use flake
